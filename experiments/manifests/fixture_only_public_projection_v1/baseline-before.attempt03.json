ments = ['-q', '-p', 'no:cacheprovider', '-p', 'no:logging', '--assert=plain', '--capture=sys', '-c', 'pyproject.toml'] + selected\noutput = io.StringIO()\nwith contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):\n    status = int(pytest.main(arguments, plugins=[plugin]))\nloaded_neural = sorted(m for m in sys.modules if m.split('.')[0] in denied_roots or m.startswith(('src.models', 'src.inference')))\nresult = {'schema_version': 'fixture_projection_test_result_v1', 'provenance': 'NONSCIENTIFIC',\n    'label': label, 'selected': selected, 'pytest_arguments': arguments,\n    'python_version': sys.version, 'dependency_versions': {n: importlib.metadata.version(n) for n in ['numpy', 'pytest', 'unicodedata2']},\n    'source_sha256': {p: hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in sorted(set(allowed_relative))},\n    'nodes': plugin.nodes, 'node_outcomes': plugin.node_outcomes,\n    'counts': plugin.counts, 'pytest_exit_status': status,\n    'elapsed_runner_seconds': time.perf_counter() - started,\n    'isolation': {'blocked_events': blocks, 'loaded_neural_modules': loaded_neural,\n        'repository_bytecode_cache_reads_excluded': sorted(source_only_cache_attempts),\n        'allowed_repository_reads_observed': sorted(reads),\n        'network_and_subprocess_audit_hooks': True, 'read_allowlist': sorted(allowed_relative),\n        'file_writes_blocked': True, 'neural_imports_blocked': True,\n        'numpy_array_loading_blocked': True, 'plugin_autoload_disabled': os.environ.get('PYTEST_DISABLE_PLUGIN_AUTOLOAD') == '1',\n        'acceptance_test_body_tripwires': 'Exact accepted synthetic_isolation fixture retained'},\n    'output': output.getvalue()}\nprint(json.dumps(result, sort_keys=True))\nsys.exit(status)\n",
